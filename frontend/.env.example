# ──────────────────────────────────────────────
# NPL Cricket Auction — Frontend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local for local development
# Set these same variables in Vercel → Project Settings → Environment Variables
#
# For LOCAL development (backend on your machine):
# VITE_API_URL=http://localhost:8000/api
# VITE_WS_URL=ws://localhost:8000/ws/auction
# VITE_BACKEND_URL=http://localhost:8000
#
# For PRODUCTION (backend on Oracle Cloud — replace with your HTTPS domain):
# VITE_API_URL=https://92-4-76-201.sslip.io/api
# VITE_WS_URL=wss://92-4-76-201.sslip.io/ws/auction
# VITE_BACKEND_URL=https://92-4-76-201.sslip.io

VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/auction
VITE_BACKEND_URL=http://localhost:8000
