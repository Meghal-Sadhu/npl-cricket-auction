{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cgi-creativity-title-rachel.trycloudflare.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "wss://cgi-creativity-title-rachel.trycloudflare.com/ws/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
